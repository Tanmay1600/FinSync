# WhatsApp Bot Configuration (example)
# Copy to .env and fill in with your credentials.

# WhatsApp Cloud API Credentials
APP_ID=your_app_id_here
APP_SECRET=your_app_secret_here
ACCESS_TOKEN=your_access_token_here
PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id_here
WHATSAPP_API_VERSION=v17.0

# Test number (include country code)
TEST_NUMBER=+1234567890

# Verify token for Meta webhook setup
VERIFY_TOKEN=my_custom_verify_token

# Optional: internal backend integrations
BACKEND_BASE_URL=https://your-backend-api.com/api

# Interaction API (Hack The Tank backend)
INTERACTIONS_API_URL=https://your-backend.com/api/interactions
INTERACTIONS_API_TOKEN=your_jwt_token_here
DEFAULT_TAG_IDS=1,2

# Authentication (encrypted phone login)
AUTH_API_URL=http://localhost:5000/api/auth/encrypted-login
AES_KEY=your_base64_encoded_32_byte_key_here

# Cloudinary (used for uploading images/audio)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=

# Gemini API (for visiting card extraction and audio transcription)
GEMINI_API_KEY=your_gemini_api_key_here

# Offline Queue Configuration
QUEUE_DB_PATH=offline_queue.db
QUEUE_POLL_INTERVAL=8
